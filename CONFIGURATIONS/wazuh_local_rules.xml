<!-- Local rules -->
<group name="local,syslog,sshd,windows,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Stage 1: Brute Force Detection for Active Response -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Active Response Trigger: 5+ failed Windows logons from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Stage 2: Scheduled Task Persistence Detection (MITRE T1053.005) -->
  <rule id="100101" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">schtasks\.exe</field>
    <match>/create</match>
    <description>Adversary Persistence: Scheduled Task Creation detected via CLI</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,sysmon_event1,</group>
  </rule>

  <!-- Stage 3: Latency Canary Process Creation Trigger (Protocol T1 Canary Rule) -->
  <rule id="100200" level="5">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">siemcanary</field>
    <description>Latency canary event (research testbed)</description>
    <group>latency_canary,sysmon_event1,</group>
  </rule>

</group>
